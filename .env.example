LLM_PROVIDERS=groq,groq,openrouter,xai
LLM_API_KEYS=key1,key2,key3,key4
LLM_MODELS=model1,model2,model3,model4
DATABASE_URL=postgresql://localhost/learning_path_db
TAVILY_API_KEY=your-tavily-key-here
# Secret used to sign access tokens for authz. Set a long random value in
# production/Render. If unset, tokens are signed with a per-process key
# (invalidated across restarts) - fine for dev only.
ACCESS_TOKEN_SECRET=change-me-to-a-long-random-string
